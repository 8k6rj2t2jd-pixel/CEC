# Copie este ficheiro para ".env" e preencha os valores para correr
# localmente com "npm start". Em produção (Render, Railway, etc.) defina
# estas mesmas variaveis nas configuracoes de "Environment" do servico.

ADMIN_USER=admin
# Gere com: node scripts/set-password.js "a-sua-senha"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria
# NODE_ENV=production
# DATA_DIR=/data
