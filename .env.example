# Copie este ficheiro para ".env" e preencha os valores para correr
# localmente com "npm start". Em produção (Render, Railway, etc.) defina
# estas mesmas variaveis nas configuracoes de "Environment" do servico.

ADMIN_USER=admin
# Gere com: node scripts/set-password.js "a-sua-senha"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria
# NODE_ENV=production

# Sem estas duas, a app guarda tudo em disco local (pasta data/). Com
# ambas definidas, guarda o catalogo no MongoDB Atlas e as fotos no
# Cloudinary - necessario para correr num servidor sem disco persistente
# (ex: plano gratuito do Render). Ver README para como obter os valores.
# MONGODB_URI=mongodb+srv://utilizador:senha@cluster0.xxxxx.mongodb.net/
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# DATA_DIR=/data
